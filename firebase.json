{
  "hosting": {
    "public": "dashboard/dist",
    "rewrites": [
      { "source": "/auth/**", "run": { "serviceId": "ai-pr-review-api", "region": "asia-south1" } },
      { "source": "/api/**", "run": { "serviceId": "ai-pr-review-api", "region": "asia-south1" } },
      { "source": "/health", "run": { "serviceId": "ai-pr-review-api", "region": "asia-south1" } },
      { "source": "/webhook", "run": { "serviceId": "ai-pr-review-api", "region": "asia-south1" } },
      { "source": "/internal/**", "run": { "serviceId": "ai-pr-review-api", "region": "asia-south1" } },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
