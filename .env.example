# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/pr_bot

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_APP_SLUG=

# LLM via OpenRouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_TOKENS=900
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI PR Review Bot

# Review limits
MAX_DIFF_CHARS=25000
MAX_REVIEW_COMMENTS=6
LLM_DAILY_LIMIT=40
LLM_MINUTE_LIMIT=5

# Dashboard auth
JWT_SECRET=
JWT_EXPIRY_SECONDS=604800
SESSION_REFRESH_INTERVAL_SECONDS=3600
COOKIE_SECURE=false

# Billing (optional Razorpay Checkout / hosted links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_PAYMENT_LINK_URL=
RAZORPAY_CUSTOMER_PORTAL_URL=
